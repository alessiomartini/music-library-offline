# Local source and generated media
*.mp3
*.wav
*.flac
*.m4a
*.aac
*.ogg
*.mid
*.midi
*.kar

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Large local models and temporary files
*.pt
*.pth
*.onnx
*.tmp
*.temp

# Keep final normalized JSON output trackable.
pipeline/*.egg-info/

# midi-intake: ephemeral reports and the local (possibly personal) source
# override map; source-overrides.example.json stays tracked as a template.
midi-intake/report-*.json
midi-intake/source-overrides.json
